# Newsdesk secrets. This file is gitignored and never leaves your machine.

# Required for real summaries. https://aistudio.google.com -> Get API key
GEMINI_API_KEY=paste-your-key-here

# Optional. Raises GitHub search from 10 to 30 requests/minute.
# GITHUB_TOKEN=

# Optional. Only needed if you turn on notify.telegram in settings.yaml.
#   @BotFather -> /newbot -> copy the token here, then run
#   `python run.py --test-telegram` and it will find your chat id for you.
#   Destination must be one you control: a DM with the bot, or your own
#   channel with the bot as admin. Reading someone else's public channel
#   needs none of this.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=
